# FastAPI Configuration
PORT=8000
DEBUG=True

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
# OPENAI_RAG_MODEL=gpt-5.6-luna
# OPENAI_EXTRACTION_MAX_COMPLETION_TOKENS=2000

# RAG_INPUT_TPM=100000
# RAG_OUTPUT_TPM=50000
# GRAPH_INPUT_TPM=200000
# GRAPH_OUTPUT_TPM=100000

# Environment
ENVIRONMENT=development

# Gemini — OPTIONAL. Needed to OCR images and handwriting, and to write
# revision-note sections (POST /api/notes/sections/{id}/write). Planning a
# note uses OpenAI and works without this; opening a section to read it does not.
# PDF, DOCX and PPTX extraction works without it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Older name for the same key, still accepted. Set GEMINI_API_KEY instead.
GEMINI_VISION_API_KEY=
