# FastAPI Configuration
PORT=8000
DEBUG=True

# Single switch for the whole app: openai or groq
LLM_PROVIDER=groq

# Set the key matching LLM_PROVIDER above.
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional provider-specific overrides. Normally the provider switch is all
# you need to change.
# OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
# GROQ_EXTRACTION_MODEL=qwen/qwen3.8-27b
# OPENAI_EXTRACTION_MAX_COMPLETION_TOKENS=2000
# GROQ_EXTRACTION_MAX_COMPLETION_TOKENS=2000

# Environment
ENVIRONMENT=development

# Gemini — OPTIONAL. Needed to OCR images and handwriting, and to write
# revision-note sections (POST /api/notes/sections/{id}/write). Planning a
# note uses Groq and works without this; opening a section to read it does not.
# PDF, DOCX and PPTX extraction works without it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Older name for the same key, still accepted. Set GEMINI_API_KEY instead.
GEMINI_VISION_API_KEY=
